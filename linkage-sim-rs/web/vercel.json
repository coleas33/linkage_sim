{
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/magcoupling/:path*",
      "has": [{ "type": "host", "value": "linkage.colesorkness.com" }],
      "destination": "https://colesorkness.com/magcoupler/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "linkage.colesorkness.com" },
        { "type": "query", "key": "tool", "value": "magcoupling" }
      ],
      "destination": "https://colesorkness.com/magcoupler/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "linkage.colesorkness.com" }],
      "destination": "https://colesorkness.com/linkage/:path*",
      "permanent": true
    },
    {
      "source": "/magcoupling/:path*",
      "destination": "/magcoupler/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/linkage/linkage-web.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/magcoupler/magcoupling-web.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
